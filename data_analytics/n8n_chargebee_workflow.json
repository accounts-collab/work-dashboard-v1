    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst list = items[0].json.list || [];\nlet totalMRR = 0;\nlet active = 0;\nlet cancelled = 0;\n\nlist.forEach(item => {\n  const sub = item.subscription || item;\n  if (sub.status === 'active') {\n    active++;\n    totalMRR += parseFloat(sub.mrr || 0) / 100;\n  } else if (sub.status === 'cancelled') {\n    cancelled++;\n  }\n});\n\nreturn [\n  { json: { Metric: 'Active Subscriptions', Value: active } },\n  { json: { Metric: 'Cancelled Subscriptions', Value: cancelled } },\n  { json: { Metric: 'Monthly Recurring Revenue (MRR)', Value: totalMRR } },\n  { json: { Metric: 'Annual Run Rate (ARR)', Value: totalMRR * 12 } },\n  { json: { Metric: 'Overall Churn Rate', Value: ((cancelled / (active + cancelled)) * 100).toFixed(2) + '%' } }\n];"
      },
